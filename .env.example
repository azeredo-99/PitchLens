# Copy to .env (gitignored). Never commit real values. See docs/SPEC.md §17.

# Where the pipeline keeps raw cache, staged Parquet and DuckDB (default: ./data)
PITCHLENS_DATA_DIR=./data

# Phase 2+: local Postgres from compose.yaml
# DATABASE_URL=postgresql+psycopg://pitchlens:pitchlens@localhost:5432/pitchlens

# Phase 4+: football-data.org token
# FOOTBALL_DATA_TOKEN=

# Phase 5+: Claude API (pipeline only, never the browser)
# ANTHROPIC_API_KEY=
